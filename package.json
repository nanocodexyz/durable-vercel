{
  "name": "nanocode-vercel-durable",
  "private": true,
  "description": "nanocode agents made durable on a Vercel Workflow World with durable-harness",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"require('fs').copyFileSync('node_modules/nanocode-ts/dist/nanocode_wasm.wasm','public/nanocode_wasm.wasm')\" && next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "cli": "node --disable-warning=ExperimentalWarning scripts/cli.ts",
    "drill": "node --disable-warning=ExperimentalWarning scripts/drill.ts"
  },
  "dependencies": {
    "@pierre/highlights": "0.2.0",
    "@vercel/functions": "3.10.4",
    "@vercel/oidc": "3.2.0",
    "durable-harness": "0.0.1-beta.6",
    "nanocode-ts": "github:nanocodexyz/nanocode-ts#0abe1e6d7d86dc939de780e6cd9f7923e52f4c07",
    "nds": "https://github.com/nanocodexyz/nds/releases/download/build-5454fa8/nds-5454fa8.tgz",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0",
    "zyzz": "0.0.40"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "typescript": "6.0.2"
  }
}
